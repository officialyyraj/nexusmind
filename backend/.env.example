# =============================================================================
# NexusMind Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All required secrets will be auto-generated if not provided.

# =============================================================================
# APPLICATION (Required for Production)
# =============================================================================

# Environment: development, staging, or production
ENVIRONMENT=development

# Set to true to enable debug mode
DEBUG=false

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusmind

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Required)
# =============================================================================
# Redis connection string
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis connection pool size
REDIS_POOL_SIZE=10

# =============================================================================
# SECURITY (Required for Production)
# =============================================================================
# JWT signing key - auto-generated if not provided
# IMPORTANT: Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session encryption key - auto-generated if not provided
# IMPORTANT: Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# =============================================================================
# LLM PROVIDERS (Optional)
# =============================================================================

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
# CHROMADB (Required)
# =============================================================================
# ChromaDB URL for remote instances (leave empty for local)
# Format: http://host:port
CHROMADB_URL=

# Local ChromaDB persistence directory
CHROMADB_PERSIST_DIRECTORY=./data/chromadb
CHROMADB_COLLECTION_NAME=nexusmind_memory

# =============================================================================
# SANDBOX EXECUTION (Optional)
# =============================================================================
# Docker image for code execution sandbox
SANDBOX_DOCKER_IMAGE=nexusmind-sandbox:latest

# Sandbox settings
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_CONCURRENT=10

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API prefix for all endpoints
API_PREFIX=/api/v1

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# STREAMING & RATE LIMITING
# =============================================================================
SSE_HEARTBEAT_SECONDS=30
RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# PATHS
# =============================================================================
# Directory for user workspaces
WORKSPACE_ROOT=./workspace

# Directory for plugins
PLUGINS_DIRECTORY=./plugins

# Temporary directory
TEMP_DIRECTORY=/tmp/nexusmind

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# STARTUP SETTINGS
# =============================================================================
# Wait timeout for dependencies (seconds)
STARTUP_DB_TIMEOUT=60
STARTUP_REDIS_TIMEOUT=30
STARTUP_CHROMADB_TIMEOUT=60

# Run Alembic migrations on startup (true/false)
RUN_MIGRATIONS=true
