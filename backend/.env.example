# =============================================================================
# NexusMind Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your production values.

# =============================================================================
# APPLICATION (Required for Production)
# =============================================================================

# Environment: "development", "staging", or "production"
ENVIRONMENT=development

# Set to true to enable debug mode
DEBUG=false

# Application log level (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/nexusmind

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# SECURITY (Required for Production)
# =============================================================================
# A strong, randomly-generated secret key for signing JWTs.
# IMPORTANT: Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080 # 7 days

# =============================================================================
# API & CORS
# =============================================================================
# API prefix for all endpoints
API_PREFIX=/api/v1

# CORS origins (comma-separated list of allowed domains)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# =============================================================================
# LLM PROVIDERS (Optional)
# =============================================================================

# Ollama (local LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# =============================================================================
# EXTERNAL SERVICES (Required)
# =============================================================================
# Redis connection string
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# ChromaDB URL
# Format: http://host:port
CHROMADB_URL=http://chromadb:8000

# =============================================================================
# STARTUP SETTINGS
# =============================================================================
# Run Alembic migrations on startup (true/false)
RUN_MIGRATIONS=true
