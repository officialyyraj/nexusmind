# NexusMind Production Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================

ENVIRONMENT=production
APP_NAME=NexusMind
APP_VERSION=1.0.0

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-me

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# CORS (comma-separated list of allowed origins)
# =============================================================================

CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# DATABASE
# =============================================================================

POSTGRES_USER=nexusmind
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nexusmind
DATABASE_URL=postgresql://nexusmind:change-me-to-a-strong-password@db:5432/nexusmind

# =============================================================================
# REDIS
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# Ollama (optional, if using local models)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# =============================================================================
# CHROMADB
# =============================================================================

CHROMADB_URL=http://chromadb:8000

# =============================================================================
# SANDBOX
# =============================================================================

SANDBOX_DOCKER_IMAGE=nexusmind-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_CONCURRENT=10

# =============================================================================
# MONITORING (for Prometheus/Grafana)
# =============================================================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# =============================================================================
# SECURITY
# =============================================================================

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080  # 7 days

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
