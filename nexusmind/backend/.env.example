# NexusMind Backend Environment Configuration

# Application
APP_NAME=NexusMind
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusmind
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Security
SECRET_KEY=change-me-in-production-use-strong-secret-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
API_KEY_HEADER=X-API-Key

# LLM Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ChromaDB
CHROMADB_PERSIST_DIRECTORY=./data/chromadb
CHROMADB_COLLECTION_NAME=nexusmind_memory

# Sandbox
SANDBOX_DOCKER_IMAGE=nexusmind-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_CONCURRENT=10

# Streaming
SSE_HEARTBEAT_SECONDS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored
